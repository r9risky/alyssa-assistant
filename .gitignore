# --- Secrets & personal data — never commit these ---
# NOTE: API keys (Gemini/OpenAI/Anthropic/ElevenLabs/custom provider) and
# Spotify/YouTube credentials now live in the OS keyring via
# credential_store.py - config.py itself no longer holds secret values,
# so it's fine to keep tracking it in git.
# Google OAuth client secret (plugins/calendar_gmail.py) - user-provided,
# downloaded from Google Cloud Console.
credentials.json
# Google OAuth refresh token for the user's actual Calendar/Gmail
# (plugins/calendar_gmail.py) - written automatically after first sign-in.
token.json
# Persistent assistant memory (memory.py) - personal facts the user has
# asked Alyssa to remember, stored in plain text.
memory.json

# --- Python ---
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# --- Local virtual environment (created automatically by start_alyssa.bat) ---
.venv/
plans/
overlay_config.json
.alyssa-version
.alyssa-manifest.json
logs/

# --- Generated knowledge graph ---
graphify-out/

# --- Env files (in case any provider ever reads from one directly) ---
.env
.env.*

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Build artifacts (in case of a future PyInstaller/packaging step) ---
build/
dist/
*.egg-info/

# --- Downloaded voice models (Kokoro, ~120 MB) ---
models/
briefing_state.json
file_backups/
fondness.json
plugin_approvals.json
phone_remote.json

# User-changed settings (config.py holds only defaults)
settings.json
settings.json.tmp
